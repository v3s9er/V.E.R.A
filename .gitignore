release-*/

# Never commit private/signing key material from any package or platform.
*.key
*.key.pem
*.pem
*.jks
*.keystore
*.p12
*.pfx
*.pkcs12

# Public certificate PEMs remain intentionally trackable when named clearly.
!*.cert.pem
!*.certificate.pem
!*.public.pem

