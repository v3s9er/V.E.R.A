node_modules/
dist/
.expo/
.expo-shared/
web-build/
*.log
.env
.env.*
.dev.vars
.dev.vars.*
.wrangler/
.mr-robot/
# Runtime state normally lives under ~/.mr-robot. These anchored entries are a
# second fail-safe for development sessions that explicitly point MR_ROBOT_HOME
# at the repository root. They cover conversations, device links, provider and
# plugin state, Cloudflare connector files, shared user files, and voice assets.
/config.json
/config.json.bak
/conversations.json
/conversations.json.bak
/memory.json
/schedules.json
/routing-traces.jsonl
/pairing-secret.dpapi
/context-cache/
/plugins/*.json
/private/
/runtime/
/shared/
/voice/
/docker/
/signing/
*.dpapi
.mr-robot-output/
.mr-robot-*.part
# Private calendar sources and exports must never enter source control.
*.xlsx
*.xls
*.xlsm
*.xlsb
*.ods
*.csv
*.numbers
*.pfx
*.p12
*.pem
*.key
private-calendar/
work-calendar-private/
# Also covers MR_ROBOT_HOME pointed directly at the repository root.
private/work-calendar/
.ui-*/
.voice-validation/
.DS_Store
*.tsbuildinfo
packages/desktop/.stage/
apps/mobile/android/.gradle/
apps/mobile/android/.kotlin/
apps/mobile/android/app/build/
apps/mobile/android/app/src/generated-assets/
apps/mobile/android/local.properties
release-*/

# Never commit private/signing key material from any package or platform.
*.key
*.key.pem
*.pem
*.jks
*.keystore
*.p12
*.pfx
*.pkcs12

# Public certificate PEMs remain intentionally trackable when named clearly.
!*.cert.pem
!*.certificate.pem
!*.public.pem

