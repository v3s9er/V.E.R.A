{
  "appId": "com.polaris.mrrobot",
  "productName": "Mr.Robot",
  "electronVersion": "43.7.7",
  "asar": true,
  "asarUnpack": ["integrations/discordbot/**", "integrations/lid-display/**", "integrations/computer-use/**", "integrations/local-training/**", "plugins/mr-robot/scripts/**"],
  "compression": "maximum",
  "electronLanguages": ["en", "ko"],
  "directories": {
    "app": ".stage",
    "output": "../../release"
  },
  "files": ["**/*"],
  "win": {
    "icon": "build/icon.png",
    "target": ["nsis"],
    "artifactName": "Mr.Robot-Setup-${version}-${arch}.${ext}"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowElevation": true,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Mr.Robot"
  }
}
