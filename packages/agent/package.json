    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@mr-robot/shared": "*",
    "express": "^5.2.1",
    "fflate": "0.8.2",
    "ws": "^8.18.0",
    "zod": "^4.4.3"
  }
}
