release/*.exe filter=lfs diff=lfs merge=lfs -text
release/mobile/*.apk filter=lfs diff=lfs merge=lfs -text
# Installer/APK blobs remain GitHub release assets and LFS objects, not source
# archive contents. This also keeps GitHub's automatically generated source ZIP
# aligned with scripts/create-public-source-archive.mjs.
release/** export-ignore
THIRD_PARTY_NOTICES.txt text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.json text eol=lf
*.md text eol=lf
*.css text eol=lf
*.html text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
